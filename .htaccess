# Genta CMS
Options -Indexes

<IfModule mod_rewrite.c>
RewriteEngine On

# Auto base path (works in / or /cms/)
RewriteBase /

# Prevent uploaded PHP files from being served or executed.
RewriteRule ^uploads/.*\.php$ - [F,L,NC]

# URL lama halaman statis -> URL baru (.php)
RewriteRule ^public/home/(index\.html)?$ /index.php [R=301,L]
RewriteRule ^public/pages/home\.html$ /index.php [R=301,L]
RewriteRule ^public/pages/([A-Za-z0-9_-]+)\.html$ /$1.php [R=301,L]

# Don't rewrite real files/folders
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Block direct access to sensitive folders
RewriteRule ^database/ - [F,L]
RewriteRule ^config/ - [F,L]
RewriteRule ^includes/ - [F,L]

# Admin folder - pass through
RewriteRule ^admin/ - [L]

# Front controller
RewriteRule ^(.*)$ index.php [QSA,L]
</IfModule>
