# Vanilla PHP CMS by vzy
Options -Indexes

<IfModule mod_rewrite.c>
RewriteEngine On

# Auto base path (works in / or /cms/)
RewriteBase /

# Prevent uploaded PHP files from being served or executed.
RewriteRule ^uploads/.*\.php$ - [F,L,NC]

# Don't rewrite real files/folders
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Block direct access to sensitive folders
RewriteRule ^database/ - [F,L]
RewriteRule ^config/ - [F,L]
RewriteRule ^includes/ - [F,L]

# Admin folder - pass through
RewriteRule ^admin/ - [L]

# Front controller
RewriteRule ^(.*)$ index.php [QSA,L]
</IfModule>
